#!/bin/bash

# Define source and destination
SOURCE_DIR="python_server"
DEST_USER="nigel"
DEST_HOST="raspberrypi"
DEST_PATH="/home/nigel/RaspNest/"

echo "Deploying ${SOURCE_DIR} to ${DEST_USER}@${DEST_HOST}:${DEST_PATH}"

# Use scp to copy the directory recursively
scp -r "${SOURCE_DIR}" "${DEST_USER}"@"${DEST_HOST}":"${DEST_PATH}"

if [ $? -eq 0 ]; then
    echo "Deployment successful!"
else
    echo "Deployment failed. Please check your connection and credentials."
fi
